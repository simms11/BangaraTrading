# =====================================================================
# Bangarah marketplace — environment configuration
# Copy to .env (local) or set in Vercel / hosting provider for prod.
# =====================================================================

# --- Core ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="Bangarah Trading"

# --- Payload CMS ---
# Generate a strong secret: openssl rand -base64 32
PAYLOAD_SECRET=replace-me-with-strong-random-secret

# --- Database (Postgres / Neon) ---
# Local dev: docker run --name bangarah-pg -e POSTGRES_PASSWORD=postgres -p 5432:5432 -d postgres:16
# Prod: use Neon (https://neon.tech) pooled connection string with ?sslmode=require
DATABASE_URL=postgres://postgres:postgres@localhost:5432/bangarah
# Pool sizing — Vercel serverless: each function instance opens its own
# pool. Total connections = DATABASE_POOL_MAX × N concurrent instances.
# Neon free tier ≈ 100 connections; paid ≈ 300. Recommend:
#   Vercel:    DATABASE_POOL_MAX=3 (so 3 × ~20 instances = 60)
#   Render/Fly: DATABASE_POOL_MAX=10 (long-lived process)
DATABASE_POOL_MAX=10
DATABASE_POOL_IDLE_MS=30000
DATABASE_POOL_CONNECT_MS=5000

# --- Payments: Stripe (international card acceptance) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Payments: Flutterwave (Africa + NA/ZA card acceptance) ---
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM="Bangarah Trading <orders@bangarahtradingenterprises.com>"
# Where new-quote alerts go (Phase 3). Customer ack mails go to the buyer.
OPS_EMAIL=enquiry@bangarahtradingenterprises.com

# --- Media storage (Cloudflare R2) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=bangarah-media
R2_PUBLIC_URL=https://media.bangarahtradingenterprises.com

# --- Search (Typesense) ---
TYPESENSE_HOST=
TYPESENSE_PORT=443
TYPESENSE_PROTOCOL=https
TYPESENSE_API_KEY=
TYPESENSE_SEARCH_ONLY_KEY=

# --- Shipping (EasyPost — optional) ---
# When set, real carrier rates replace the flat-rate tiers at checkout.
# Without it, Bangarah's pickup + flat-rate tiers ship cleanly.
EASYPOST_API_KEY=

# Ship-from origin (overrides defaults if provided)
SHIP_FROM_STREET1=
SHIP_FROM_CITY=
SHIP_FROM_ZIP=
SHIP_FROM_PHONE=

# --- Observability ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
# pino log level: trace, debug, info, warn, error, fatal
LOG_LEVEL=info

# --- Rate limiting (Upstash Redis) ---
# Production: set both to enable durable, multi-region rate limiting.
# Local dev: leave blank and the in-memory bucket takes over.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Analytics (PostHog) ---
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# --- Feature flags ---
ENABLE_VENDOR_SIGNUP=false
ENABLE_QUOTE_FLOW=true

# Set to true to remove "Manual bank transfer" as a checkout option
# once you have a real processor live.
DISABLE_MANUAL_CHECKOUT=false

# Shown on the order confirmation page + emailed to manual-mode customers.
MANUAL_PAYMENT_INSTRUCTIONS="Please transfer the order total to: Bangarah Trading Enterprises CC · Bank: <BANK NAME> · Acc: <ACCOUNT NUMBER> · Ref: <ORDER NUMBER>. We'll release your order as soon as funds clear."

# --- Dev seed ---
# Required to run POST /api/dev/seed (dev only). Set to any strong string.
SEED_TOKEN=dev
SEED_ADMIN_EMAIL=admin@bangarahtradingenterprises.com
SEED_ADMIN_PASSWORD=ChangeMe!2026

# --- Database migrations ---
# In production, set to "true" so Payload doesn't push schema on boot.
# CI/CD must run `npm run db:migrate` before serving traffic.
PAYLOAD_DISABLE_SCHEMA_PUSH=false

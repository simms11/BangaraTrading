{
  "name": "bangarah",
  "version": "2.0.0",
  "private": true,
  "description": "Bangarah Trading — multi-vendor marketplace + B2B quote platform",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "generate:types": "curl -fsS -X POST -H \"x-seed-token: ${SEED_TOKEN:-dev}\" ${SEED_URL:-http://localhost:3000}/api/dev/generate-types | jq .",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "seed": "curl -fsS -X POST -H \"x-seed-token: ${SEED_TOKEN:-dev}\" ${SEED_URL:-http://localhost:3000}/api/dev/seed | jq .",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "test:integration": "vitest run --config vitest.config.ts",
    "test:integration:watch": "vitest --config vitest.config.ts",
    "test:integration:setup-db": "tsx tests/integration/setup-db.ts",
    "lhci": "lhci autorun",
    "check:bundle": "node scripts/check-bundle-size.mjs build.log",
    "db:migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "db:migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
    "db:migrate:status": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:status"
  },
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=10"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.85.0",
    "@payloadcms/next": "3.85.0",
    "@payloadcms/plugin-seo": "^3.85.0",
    "@payloadcms/richtext-lexical": "3.85.0",
    "@payloadcms/storage-s3": "^3.85.0",
    "@payloadcms/ui": "3.85.0",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-navigation-menu": "^1.2.5",
    "@radix-ui/react-slot": "^1.1.2",
    "@react-email/components": "^0.0.40",
    "@react-email/render": "^1.4.0",
    "@sentry/nextjs": "^10.56.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^7.0.3",
    "graphql": "^16.10.0",
    "lucide-react": "^0.475.0",
    "nanoid": "^5.1.11",
    "next": "15.4.11",
    "payload": "3.85.0",
    "pino": "^9.14.0",
    "react": "19.1.2",
    "react-dom": "19.1.2",
    "resend": "^4.8.0",
    "sharp": "0.33.5",
    "stripe": "^17.7.0",
    "tailwind-merge": "^3.0.1",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.24.1"
  },
  "overrides": {
    "dompurify": "^3.4.8",
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.0"
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.0.6",
    "@types/node": "^22.13.1",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "eslint": "^9.20.1",
    "eslint-config-next": "15.4.11",
    "postcss": "^8.5.2",
    "tailwindcss": "^4.0.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.8"
  }
}
